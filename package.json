{
  "name": "private-monorepo",
  "version": "0.0.0",
  "private": true,
  "scripts": {
    "prepare": "husky",
    "build": "pnpm -r build",
    "dev": "pnpm -r --parallel dev",
    "start": "pnpm --filter basic-example start",
    "make-release": "node scripts/make-release.ts packages/fastify-file-router",
    "clean": "rimraf dist packages/**/dist demos/**/dist .nx node_modules packages/**/node_modules demos/**/node_modules",
    "format": "oxfmt .",
    "lint": "oxlint .",
    "lint:fix": "oxlint --fix .",
    "tsc": "tsc -b",
    "test": "pnpm vitest",
    "cloc": "npx cloc * --exclude-dir=node_modules,dist,.nx,.next,build"
  },
  "devDependencies": {
    "@types/node": "^24",
    "@vitest/coverage-v8": "^4.1.10",
    "chalk": "^5.6.2",
    "glob": "^13.0.0",
    "husky": "^9.1.7",
    "jsonfile": "^6.2.0",
    "oxfmt": "^0.58.0",
    "oxlint": "^1.73.0",
    "prompt-confirm": "^2.0.4",
    "rimraf": "^6.1.3",
    "semver": "^7.7.3",
    "typescript": "^7",
    "vite": "^8.1.3",
    "vitest": "^4.1.10"
  },
  "engines": {
    "node": ">=20.0.0"
  },
  "packageManager": "pnpm@11.0.8"
}
