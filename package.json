{
  "name": "private-monorepo",
  "version": "0.0.0",
  "private": true,
  "scripts": {
    "prepare": "husky",
    "build": "pnpm -r build",
    "dev": "pnpm -r --parallel dev",
    "start": "pnpm --filter basic-example start",
    "clean": "rimraf dist packages/**/dist demos/**/dist .nx node_modules packages/**/node_modules demos/**/node_modules",
    "format": "oxfmt .",
    "lint": "oxlint .",
    "lint:fix": "oxlint --fix .",
    "tsc": "tsc -b",
    "test": "vitest run",
    "cloc": "npx cloc * --exclude-dir=node_modules,dist,.nx,.next,build",
    "test:coverage": "pnpm test --coverage",
    "size": "size-limit",
    "release:prepare": "node scripts/prepare-release.mjs",
    "release": "semantic-release",
    "commitlint": "commitlint"
  },
  "devDependencies": {
    "@commitlint/cli": "^21.2.2",
    "@commitlint/config-conventional": "^21.2.2",
    "@semantic-release/changelog": "^7.0.0",
    "@semantic-release/git": "^11.0.1",
    "@size-limit/file": "^14.0.0",
    "@types/node": "^24.13.5",
    "@vitest/coverage-v8": "^4.1.11",
    "chalk": "^5.6.2",
    "conventional-changelog-conventionalcommits": "^10.4.0",
    "glob": "^13.0.6",
    "husky": "^9.1.7",
    "jsonfile": "^6.2.1",
    "oxfmt": "^0.58.0",
    "oxlint": "^1.83.0",
    "prompt-confirm": "^2.0.4",
    "rimraf": "^6.1.3",
    "semantic-release": "^25.0.9",
    "semver": "^7.8.5",
    "size-limit": "^14.0.0",
    "typescript": "^7.0.2",
    "vite": "^8.3.0",
    "vitest": "^4.1.11"
  },
  "size-limit": [
    {
      "name": "Published JavaScript (gzip, excluding dependencies)",
      "path": [
        "packages/fastify-file-router/dist/**/*.js",
        "!packages/fastify-file-router/dist/**/*.test.js",
        "!packages/fastify-file-router/dist/**/*.spec.js"
      ],
      "limit": "25 kB",
      "gzip": true,
      "brotli": false
    }
  ],
  "engines": {
    "node": ">=24.10.0"
  },
  "packageManager": "pnpm@11.0.8"
}
