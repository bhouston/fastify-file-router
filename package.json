{
  "name": "fastify-file-router-monorepo",
  "version": "0.0.0",
  "private": true,
  "type": "module",
  "scripts": {
    "prepare": "husky",
    "build": "pnpm -r build",
    "dev": "pnpm -r --parallel dev",
    "start": "pnpm --filter basic-example start",
    "clean": "rimraf dist packages/**/dist demos/**/dist .nx node_modules packages/**/node_modules demos/**/node_modules",
    "format": "oxfmt .",
    "lint": "oxlint .",
    "lint:fix": "oxlint --fix .",
    "tsc": "pnpm -r tsc",
    "test": "vitest run",
    "cloc": "npx cloc * --exclude-dir=node_modules,dist,.nx,.next,build",
    "test:coverage": "pnpm test --coverage",
    "size": "size-limit",
    "release:prepare": "node scripts/prepare-release.mjs",
    "release": "semantic-release",
    "commitlint": "commitlint",
    "release:check": "node scripts/check-release.mjs"
  },
  "devDependencies": {
    "@anolilab/semantic-release-pnpm": "^8.1.25",
    "@commitlint/cli": "^21.2.2",
    "@commitlint/config-conventional": "^21.2.2",
    "@size-limit/file": "^14.0.0",
    "@types/node": "^24.13.5",
    "@visulima/yaml": "1.0.0",
    "@vitest/coverage-v8": "^5.0.2",
    "chalk": "^5.6.2",
    "conventional-changelog-conventionalcommits": "^9.3.1",
    "glob": "^13.0.6",
    "husky": "^9.1.7",
    "jsonfile": "^6.2.1",
    "lint-staged": "^17.3.0",
    "oxfmt": "^0.58.0",
    "oxlint": "^1.83.0",
    "prompt-confirm": "^2.0.4",
    "rimraf": "^6.1.3",
    "semantic-release": "^25.0.9",
    "semver": "^7.8.5",
    "size-limit": "^14.0.0",
    "typescript": "^7.0.2",
    "vite": "^8.3.0",
    "vitest": "^5.0.2"
  },
  "lint-staged": {
    "*.{js,jsx,ts,tsx,mjs,cjs}": [
      "oxfmt",
      "oxlint --fix"
    ],
    "*.{json,jsonc,md,mdx,css,html,yml,yaml}": "oxfmt"
  },
  "size-limit": [
    {
      "name": "Published JavaScript (gzip, excluding dependencies)",
      "path": [
        "packages/fastify-file-router/dist/**/*.js",
        "!packages/fastify-file-router/dist/**/*.test.js",
        "!packages/fastify-file-router/dist/**/*.spec.js"
      ],
      "limit": "25 kB",
      "gzip": true,
      "brotli": false
    }
  ],
  "engines": {
    "node": ">=22"
  },
  "packageManager": "pnpm@11.27.0"
}
