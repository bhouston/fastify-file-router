{
  "$schema": "https://typedoc.org/schema.json",
  "entryPoints": ["../fastify-file-router/src/index.ts", "../fastify-file-router/src/FastifyFileRouterOptions.ts"],
  "tsconfig": "../fastify-file-router/tsconfig.json",
  "out": "docs/api",
  "plugin": ["typedoc-plugin-markdown"],
  "name": "API reference",
  "readme": "none",
  "entryFileName": "modules",
  "outputFileStrategy": "modules",
  "hidePageHeader": true,
  "hideBreadcrumbs": true,
  "sort": ["source-order"],
  "excludePrivate": true,
  "excludeInternal": true,
  "disableSources": true,
  "groupOrder": ["Functions", "Classes", "*"],
  "interfacePropertiesFormat": "table",
  "parametersFormat": "table",
  "typeDeclarationFormat": "table",
  "useCodeBlocks": true,
  "excludeExternals": true,
  "intentionallyNotExported": ["TypedRouteHandler", "TypedZodRouteHandler"]
}
